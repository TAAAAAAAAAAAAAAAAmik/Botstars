[Unit]
Description=AraStars Bot (клиент + встроенная админ-панель)
After=network.target ara-backend.service
Wants=ara-backend.service

[Service]
User=root
WorkingDirectory=/root/AraStars
ExecStart=/root/AraStars/venv/bin/python bot.py
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/root/AraStars

[Install]
WantedBy=multi-user.target
