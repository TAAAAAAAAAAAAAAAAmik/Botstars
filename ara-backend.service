[Unit]
Description=AraStars Backend (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=tamik
Group=tamik
WorkingDirectory=/home/tamik/botstars
ExecStart=/home/tamik/botstars/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
