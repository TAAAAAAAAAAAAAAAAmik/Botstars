# ==========================================================================
# AraStars — пример конфигурации. Скопируйте в .env и заполните.
#   cp .env.example .env && nano .env
# Файл .env содержит боевые секреты и никогда не попадает в git.
# ==========================================================================

# --- Telegram ---
# Токен бота от @BotFather
BOT_TOKEN=
# Username бота без @ (для реферальных ссылок)
BOT_USERNAME=
# Telegram ID владельца. ТОЛЬКО этот пользователь видит /admin.
ADMIN_CHAT_ID=6887373040
# Username поддержки
SUPPORT_USERNAME=@AraStarsS_Manager

# --- Бэкенд ---
BACKEND_URL=http://127.0.0.1:8000
# ОБА токена обязательны и должны быть разными.
# Сгенерировать:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Сервисный — для обычных запросов бота.
BACKEND_SERVICE_TOKEN=
# Административный — для подтверждения заказов, выплат, смены цен.
BACKEND_ADMIN_TOKEN=
# Бэкенд обязан слушать 127.0.0.1. Менять только осознанно.
BACKEND_ALLOW_PUBLIC_BIND=false

# --- База данных ---
ORDERS_DB_PATH=orders.db
DB_TIMEOUT_SECONDS=15

# --- Цены (рублей за звезду) ---
PRICE_50_99=1.50
PRICE_100_4999=1.32
PRICE_5000_PLUS=1.24
SALE_PRICE_PER_STAR=1.20
USD_RATE=90

# --- Реферальная программа ---
REFERRAL_MIN_WITHDRAW=500
# Потолок суммарной выплаты по цепочке, % от маржи заказа.
# Выше 100 ставить нельзя — заказы будут уходить в убыток.
REFERRAL_MAX_PAYOUT_PERCENT=90

# --- Реквизиты для оплаты ---
CARD_NUMBER=
CARD_DISPLAY=
CARD_HOLDER=
PAYMENT_REQUISITES_TEXT=

# --- Fragment (покупка звёзд) ---
FRAGMENT_API_URL=https://fragment.com/api
# Заполнять НЕ нужно: бот сам достаёт актуальный hash со страницы Fragment
# по вашим cookies и обновляет его каждые 5 минут.
FRAGMENT_HASH=
FRAGMENT_COOKIES_JSON=
FRAGMENT_ACCOUNT_ADDRESS=
FRAGMENT_ACCOUNT_CHAIN=-239
FRAGMENT_SHOW_SENDER=1
# ВАЖНО: сид-фраза горячего кошелька. Держите на кошельке только оборотную
# сумму, а копию фразы — ВНЕ сервера.
FRAGMENT_WALLET_MNEMONIC=
FRAGMENT_WALLET_VERSION=v4r2

# --- Лимиты кошелька (защита от увода средств) ---
# Максимум TON в одном сообщении перевода
FRAGMENT_MAX_TON_PER_MESSAGE=50
# Максимум TON на один заказ
FRAGMENT_MAX_TON_PER_ORDER=100
# Потолок TON за 1000 звёзд. Ориентир ~2-3 TON, значение взято с запасом.
FRAGMENT_MAX_TON_PER_1000_STARS=9
FRAGMENT_MAX_MESSAGES_PER_ORDER=4
# Ожидание подтверждения перевода сетью, секунд
FRAGMENT_SEQNO_CONFIRM_TIMEOUT=90
FRAGMENT_SEQNO_POLL_INTERVAL=3

# --- TON ---
TONCENTER_SEND_BOC_URL=https://toncenter.com/api/v2/sendBoc
TONCENTER_RUNGET_URL=https://toncenter.com/api/v2/runGetMethod
# Без ключа toncenter жёстко лимитирует запросы
TONCENTER_API_KEY=

# --- Автосверка платежей Ozon ---
OZON_USE_SELENIUM=true
OZON_COOKIES_JSON=
OZON_CHROME_PROFILE_DIR=/root/AraStars/ozon_chrome_profile
OZON_HEADLESS=true
OZON_CHECK_INTERVAL_SECONDS=15
OZON_OPERATIONS_PER_PAGE=30
OZON_COOKIE_KEEPALIVE_INTERVAL_SECONDS=600
OZON_COOKIE_KEEPALIVE_JITTER_SECONDS=120
OZON_COOKIE_SAVE_MIN_INTERVAL_SECONDS=300
OZON_SELENIUM_TIMEOUT_SECONDS=45
# PIN обязателен для входа. Значения по умолчанию в коде НЕТ.
OZON_PIN=
OZON_PIN_WAIT_SECONDS=12
# Как часто напоминать о протухшей сессии Ozon, секунд
OZON_REAUTH_NOTIFY_INTERVAL_SECONDS=3600

# --- Прочее ---
# Антифлуд: минимальный интервал между действиями пользователя, секунд
THROTTLE_SECONDS=0.4
BROADCAST_DELAY_SECONDS=0.05
TONVIEWER_MAX_PAGES=50
ADMIN_STATS_CACHE_TTL_SECONDS=10
WELCOME_PHOTO_PATH=assets/welcome.png
HELP_TELEGRAPH_URL=https://telegra.ph/AraStars-05-12
REFERRAL_INFO_URL=https://telegra.ph/Referalnaya-programma-AraStars-05-07
