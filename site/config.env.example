# Данные для подстановки в документы. Скопируйте в config.env и заполните.
#   cp config.env.example config.env && nano config.env && ./build.sh
# config.env содержит персональные данные и в git не попадает.

# ФИО полностью, как в паспорте
SELLER_NAME="Иванов Иван Иванович"

# ИНН (12 цифр для физлица/самозанятого)
SELLER_INN="123456789012"

# Почта для юридически значимых сообщений и обращений по персданным
SELLER_EMAIL="support@example.com"

# Телеграм поддержки, с собакой
SUPPORT_TG="@AraStarsS_Manager"

# Адрес сайта без слеша на конце
SITE_URL="https://arastars.example.com"

# Ссылка на бота
BOT_URL="https://t.me/your_bot_username"

# Дата редакции документов
DOC_DATE="1 ноября 2026 г."
