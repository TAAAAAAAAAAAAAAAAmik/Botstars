[Unit]
Description=AraStars Admin Bot (Telegram)
After=network-online.target ara-backend.service
Wants=network-online.target

[Service]
Type=simple
User=tamik
Group=tamik
WorkingDirectory=/home/tamik/botstars
ExecStart=/home/tamik/botstars/venv/bin/python admin_bot.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
